// =========================================================
// SALDO NA ADQUIRENTE + SAQUE AUTOMATICO (TESOURARIA)
// =========================================================

/// Último saldo conhecido da NOSSA conta em cada adquirente. O valor é da
/// adquirente (consulta na API dela), não do ledger do lojista — por isso vive
/// fora de `saldos_usuarios`. É um cache/snapshot: a fonte de verdade continua
/// sendo a adquirente, e cada consulta faz upsert aqui.
model SaldoAdquirente {
  contaProvedorId  BigInt   @id @map("conta_provedor_id")
  moeda            String   @default("BRL") @db.VarChar(3)
  saldoDisponivel  Decimal  @default(0) @map("saldo_disponivel") @db.Decimal(19, 2)
  saldoBloqueado   Decimal  @default(0) @map("saldo_bloqueado") @db.Decimal(19, 2)
  /// Última consulta bem-sucedida à adquirente.
  consultadoEm     DateTime @default(now()) @map("consultado_em") @db.Timestamptz
  /// Preenchido quando a última consulta falhou (o saldo acima fica velho).
  erroUltimaConsulta String? @map("erro_ultima_consulta")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm     DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  contaProvedor    ContaProvedor @relation(fields: [contaProvedorId], references: [id])

  @@map("saldos_adquirentes")
}

/// Regra de saque automático do dinheiro parado na adquirente para uma chave
/// PIX nossa. Uma conta pode ter VÁRIOS gatilhos (avaliados por `ordem`); o
/// primeiro elegível na rodada dispara e os demais só na próxima.
model GatilhoSaqueAdquirente {
  id                     BigInt       @id @default(autoincrement())
  idPublico              String       @unique @default(uuid()) @map("id_publico") @db.Uuid
  contaProvedorId        BigInt       @map("conta_provedor_id")
  nome                   String       @db.VarChar(120)
  ativo                  Boolean      @default(true)
  /// Ordem de avaliação quando há mais de um gatilho na mesma conta.
  ordem                  Int          @default(0)
  /// Dispara quando o saldo disponível na adquirente atinge este valor.
  valorGatilho           Decimal      @map("valor_gatilho") @db.Decimal(19, 2)
  /// Valor que NUNCA sai da conta na adquirente (float operacional).
  valorReserva           Decimal      @default(0) @map("valor_reserva") @db.Decimal(19, 2)
  /// Piso/teto do payout: abaixo do mínimo não saca; acima do máximo saca o máximo.
  valorMinimoPayout      Decimal      @default(0) @map("valor_minimo_payout") @db.Decimal(19, 2)
  valorMaximoPayout      Decimal?     @map("valor_maximo_payout") @db.Decimal(19, 2)
  chavePix               String       @map("chave_pix") @db.VarChar(255)
  tipoChavePix           TipoChavePix @map("tipo_chave_pix")
  nomeTitular            String?      @map("nome_titular") @db.VarChar(255)
  documentoTitular       String?      @map("documento_titular") @db.VarChar(20)
  /// Janela mínima entre dois disparos do MESMO gatilho (anti-flood).
  intervaloMinimoMinutos Int          @default(60) @map("intervalo_minimo_minutos")
  ultimaExecucaoEm       DateTime?    @map("ultima_execucao_em") @db.Timestamptz
  criadoPorUsuarioId     BigInt?      @map("criado_por_usuario_id")
  atualizadoPorUsuarioId BigInt?      @map("atualizado_por_usuario_id")
  criadoEm               DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm           DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz

  contaProvedor          ContaProvedor          @relation(fields: [contaProvedorId], references: [id])
  execucoes              ExecucaoGatilhoSaque[]

  @@index([contaProvedorId, ativo])
  @@map("gatilhos_saque_adquirente")
}

/// Histórico de cada disparo (automático ou manual) de um gatilho. É o registro
/// do saque de TESOURARIA — não é `Transacao`, que é sempre dinheiro de lojista.
model ExecucaoGatilhoSaque {
  id                    BigInt   @id @default(autoincrement())
  idPublico             String   @unique @default(uuid()) @map("id_publico") @db.Uuid
  gatilhoId             BigInt   @map("gatilho_id")
  contaProvedorId       BigInt   @map("conta_provedor_id")
  /// Impede disparo duplicado na mesma janela quando o tick roda concorrente.
  chaveIdempotencia     String   @unique @map("chave_idempotencia") @db.VarChar(255)
  /// AUTOMATICO (tick da fila) ou MANUAL (botão do admin).
  origem                String   @default("AUTOMATICO") @db.VarChar(20)
  saldoObservado        Decimal  @map("saldo_observado") @db.Decimal(19, 2)
  valorSolicitado       Decimal  @map("valor_solicitado") @db.Decimal(19, 2)
  situacao              String   @default("PENDENTE") @db.VarChar(30)
  idTransacaoLiquidante String?  @map("id_transacao_liquidante") @db.VarChar(255)
  mensagemErro          String?  @map("mensagem_erro")
  solicitadoPorUsuarioId BigInt? @map("solicitado_por_usuario_id")
  metadados             Json     @default("{}")
  concluidoEm           DateTime? @map("concluido_em") @db.Timestamptz
  criadoEm              DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm          DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  gatilho               GatilhoSaqueAdquirente @relation(fields: [gatilhoId], references: [id])
  contaProvedor         ContaProvedor          @relation(fields: [contaProvedorId], references: [id])

  @@index([gatilhoId, criadoEm])
  @@index([situacao])
  @@index([criadoEm])
  @@map("execucoes_gatilho_saque")
}

// =========================================================
// CONTINGENCIA DE ADQUIRENTE
// =========================================================

/// Cadeia de contingência: ordem em que as adquirentes são tentadas quando a
/// principal do lojista falha ao criar a cobrança. Existe para NÃO PERDER A
/// VENDA — o cliente final não pode ficar sem código PIX porque uma liquidante
/// caiu.
///
/// A cadeia é sobre `contas_provedor` (e não sobre `provedores_pagamento`)
/// porque é a conta que carrega credencial, custo e habilitação de cash-in.
model ContingenciaAdquirente {
  id              BigInt   @id @default(autoincrement())
  contaProvedorId BigInt   @unique @map("conta_provedor_id")
  /// Posição na fila de tentativa (1 = primeira contingência).
  ordem           Int      @unique
  ativo           Boolean  @default(true)
  observacao      String?  @db.VarChar(255)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  contaProvedor   ContaProvedor @relation(fields: [contaProvedorId], references: [id])

  @@map("contingencia_adquirente")
}

/// Falha de uma adquirente ao criar a cobrança, com o response cru guardado
/// para conferência com a liquidante.
///
/// Uma venda gera uma linha POR TENTATIVA falha: a da principal e a de cada
/// contingência que também falhou. `resolvidaPorContaProvedorId` responde
/// "onde a cobrança acabou sendo gerada" — nulo quando nem a contingência
/// salvou e a venda foi perdida de fato.
model FalhaAdquirente {
  id                          BigInt   @id @default(autoincrement())
  idPublico                   String   @unique @default(uuid()) @map("id_publico") @db.Uuid
  /// Nula quando a falha derruba a criação antes de a transação existir.
  transacaoId                 BigInt?  @map("transacao_id")
  contaProvedorId             BigInt   @map("conta_provedor_id")
  usuarioId                   BigInt?  @map("usuario_id")
  /// TIMEOUT | ERRO_PROVEDOR | SEM_CODIGO_PIX
  tipo                        String   @db.VarChar(30)
  /// Ordem da tentativa: 0 = adquirente principal do lojista, 1+ = contingência.
  ordemTentativa              Int      @default(0) @map("ordem_tentativa")
  mensagem                    String?
  statusHttp                  Int?     @map("status_http")
  codigoErro                  String?  @map("codigo_erro") @db.VarChar(100)
  dadosRequisicao             Json?    @map("dados_requisicao")
  /// Response cru da liquidante — é o que se leva para a mesa de suporte dela.
  dadosResposta               Json?    @map("dados_resposta")
  latenciaMs                  Int?     @map("latencia_ms")
  resolvidaPorContaProvedorId BigInt?  @map("resolvida_por_conta_provedor_id")
  resolvidaEm                 DateTime? @map("resolvida_em") @db.Timestamptz
  criadoEm                    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao                   Transacao?    @relation(fields: [transacaoId], references: [id])
  contaProvedor               ContaProvedor @relation("FalhaOrigem", fields: [contaProvedorId], references: [id])
  resolvidaPor                ContaProvedor? @relation("FalhaResolucao", fields: [resolvidaPorContaProvedorId], references: [id])
  usuario                     Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@index([contaProvedorId, criadoEm])
  @@index([tipo])
  @@index([transacaoId])
  @@map("falhas_adquirente")
}
