model ConfiguracaoWebhookUsuario {
  id                     BigInt   @id @default(autoincrement())
  usuarioId              BigInt   @map("usuario_id")
  nome                   String   @db.VarChar(100)
  urlDestino             String   @map("url_destino")
  /// Header que o lojista quer receber para conferir a origem do callback
  /// (ex.: `x-key-token`). O valor vai em `segredoCriptografado`.
  nomeHeaderAutenticacao String?  @map("nome_header_autenticacao") @db.VarChar(100)
  /// Valor do header acima. Guardado cifrado e NUNCA devolvido pela API — o
  /// lojista escolhe o segredo, então quem precisa dele já o conhece.
  segredoCriptografado   String?  @map("segredo_criptografado")
  tiposEvento            Json     @default("[]") @map("tipos_evento")
  cabecalhosCriptografados Json   @default("{}") @map("cabecalhos_criptografados")
  ativo                  Boolean  @default(true)
  criadoEm               DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm           DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  entregas               EntregaWebhook[]

  @@index([usuarioId])
  @@map("configuracoes_webhook_usuario")
}

model WebhookRecebidoProvedor {
  id                        BigInt   @id @default(autoincrement())
  provedorPagamentoId       BigInt   @map("provedor_pagamento_id")
  contaProvedorId           BigInt?  @map("conta_provedor_id")
  usuarioId                 BigInt?  @map("usuario_id")
  identificadorEventoExterno String? @map("identificador_evento_externo") @db.VarChar(255)
  chaveIdempotencia         String   @unique @map("chave_idempotencia") @db.VarChar(255)
  tipoEvento                String   @map("tipo_evento") @db.VarChar(100)
  assinatura                String?  @db.VarChar(500)
  conteudo                  Json
  situacao                  String   @default("RECEBIDO") @db.VarChar(30)
  mensagemErro              String?  @map("mensagem_erro")
  recebidoEm                DateTime @default(now()) @map("recebido_em") @db.Timestamptz
  processadoEm              DateTime? @map("processado_em") @db.Timestamptz

  provedor                  ProvedorPagamento @relation(fields: [provedorPagamentoId], references: [id])
  casosMed                  CasoMed[]

  @@map("webhooks_recebidos_provedor")
}

model EventoOutbox {
  id                            BigInt    @id @default(autoincrement())
  eventoUuid                    String    @unique @default(uuid()) @map("evento_uuid") @db.Uuid
  usuarioId                     BigInt?   @map("usuario_id")
  tipoAgregado                  String    @map("tipo_agregado") @db.VarChar(100)
  identificadorAgregado         String    @map("identificador_agregado") @db.VarChar(100)
  tipoEvento                    String    @map("tipo_evento") @db.VarChar(150)
  conteudo                      Json
  ocorridoEm                    DateTime  @default(now()) @map("ocorrido_em") @db.Timestamptz
  publicadoRedisEm              DateTime? @map("publicado_redis_em") @db.Timestamptz
  quantidadeTentativasPublicacao Int      @default(0) @map("quantidade_tentativas_publicacao")
  ultimoErroPublicacao          String?   @map("ultimo_erro_publicacao")
  criadoEm                      DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  entregas                      EntregaWebhook[]

  @@index([publicadoRedisEm])
  @@map("eventos_outbox")
}

model EntregaWebhook {
  id                     BigInt    @id @default(autoincrement())
  eventoOutboxId         BigInt    @map("evento_outbox_id")
  /// Nulo quando a entrega foi para o `urlCallback` da própria operação, que
  /// não tem cadastro no painel.
  configuracaoWebhookId  BigInt?   @map("configuracao_webhook_id")
  /// URL efetivamente chamada — a config pode ser editada depois e o histórico
  /// precisa dizer para onde a entrega foi de fato.
  urlDestino             String?   @map("url_destino")
  usuarioId              BigInt    @map("usuario_id")
  numeroTentativa        Int       @map("numero_tentativa")
  situacao               String    @db.VarChar(30)
  statusHttp             Int?      @map("status_http")
  corpoResposta          String?   @map("corpo_resposta")
  mensagemErro           String?   @map("mensagem_erro")
  latenciaMs             Int?      @map("latencia_ms")
  solicitadoEm           DateTime  @default(now()) @map("solicitado_em") @db.Timestamptz
  enviadoEm              DateTime? @map("enviado_em") @db.Timestamptz
  proximaTentativaEm     DateTime? @map("proxima_tentativa_em") @db.Timestamptz
  criadoEm               DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  eventoOutbox           EventoOutbox @relation(fields: [eventoOutboxId], references: [id])
  configuracao           ConfiguracaoWebhookUsuario? @relation(fields: [configuracaoWebhookId], references: [id])

  @@unique([eventoOutboxId, configuracaoWebhookId, numeroTentativa])
  @@map("entregas_webhook")
}

