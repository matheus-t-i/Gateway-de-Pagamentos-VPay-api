generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum TipoPessoa {
  PF
  PJ
}

enum TemaPreferido {
  PADRAO
  CLARO
  ESCURO
}

/// Por onde o lojista pode pedir saque. Padrão do sistema é PAINEL — API de
/// saque é liberação explícita, feita conta a conta pelo administrador.
enum OrigemSaque {
  PAINEL
  API
  AMBOS
}

enum SituacaoUsuario {
  PENDENTE
  EM_ANALISE
  ATIVO
  REPROVADO
  SUSPENSO
  BLOQUEADO
  ENCERRADO
}

enum SituacaoDocumento {
  PENDENTE
  VALIDO
  INVALIDO
  EXPIRADO
}

enum SituacaoAnalise {
  PENDENTE
  EM_ANALISE
  APROVADA
  REPROVADA
}

enum SituacaoProvedor {
  ATIVO
  INATIVO
  SUSPENSO
}

/// Quem pode escolher a adquirente no painel: TODOS os clientes ou apenas os
/// que o administrador liberou um a um (`liberacoes_adquirente_usuario`).
enum DisponibilidadeAdquirente {
  TODOS
  ESPECIFICOS
}

enum DirecaoTransacao {
  ENTRADA
  SAIDA
}

enum SituacaoTransacao {
  PENDENTE
  PROCESSANDO
  AGUARDANDO_PAGAMENTO
  LIQUIDADA
  CONCLUIDA
  FALHA
  CANCELADA
  /// Venda devolvida ao pagador por contestação (Mecanismo Especial de
  /// Devolução). "MED" é o termo que o mercado usa para o chargeback do PIX —
  /// e é o mesmo valor que sai no callback ao lojista.
  MED
}

enum TipoSaldo {
  DISPONIVEL
  PENDENTE_LIBERACAO
  RESERVADO
  BLOQUEADO_MED
  BLOQUEADO_MANUAL
}

enum TipoMovimento {
  CREDITO
  DEBITO
}

enum NaturezaMovimentacao {
  RECEBIMENTO
  TARIFA
  RESERVA
  LIBERACAO
  SAIDA
  DEVOLUCAO_PIX
  BLOQUEIO_MED
  DESBLOQUEIO_MED
  DEBITO_MED
  BLOQUEIO_MANUAL
  DESBLOQUEIO_MANUAL
  DEBITO_MANUAL
  /// Devolução do valor + tarifa de um saque que a liquidante RECUSOU.
  /// Só para recusa confirmada — resposta ambígua não estorna, porque o
  /// dinheiro pode ter saído.
  ESTORNO_SAQUE
  AJUSTE
}

enum ModoTratamentoMed {
  BLOQUEAR_SALDO
  DEBITAR_IMEDIATAMENTE
}

enum BaseCalculoReserva {
  VALOR_BRUTO
  VALOR_LIQUIDO_EMPRESA
}

enum TipoLiberacao {
  SALDO_PRINCIPAL
  RESERVA
}

enum SituacaoLiberacao {
  AGENDADA
  PROCESSANDO
  LIBERADA
  CANCELADA
  BLOQUEADA_MED
  FALHA
}

/// Apps que o lojista conecta na própria conta (`/desenvolvedores/integracoes`).
/// Enum e não VarChar: cada valor exige um client dedicado no código, então um
/// tipo que o banco aceita e o `IntegracoesService` não conhece é lixo silencioso.
enum TipoIntegracao {
  /// Rastreio de campanhas (utm_*) para ROI de tráfego pago.
  UTMIFY
  /// Conversões por LeadId — identifica a conta pelo próprio pedido, sem credencial.
  XTRACKY
}

// =========================================================
// USUARIOS / RBAC
// =========================================================

/// O usuário É a conta: um cadastro, uma carteira, um conjunto de credenciais.
/// Não existe entidade "empresa" separada — para PJ, `cpfCnpj`/`nomeRazaoSocial`
/// são os dados da pessoa jurídica e `cpfResponsavel`/`nomeResponsavel` os do
/// responsável; para PF os dois lados são a mesma pessoa.
model Usuario {
  id                         BigInt         @id @default(autoincrement())
  idPublico                  String         @unique @default(uuid()) @map("id_publico") @db.Uuid
  tipoPessoa                 TipoPessoa     @map("tipo_pessoa")
  cpfCnpj                    String         @unique @map("cpf_cnpj") @db.VarChar(14)
  nomeRazaoSocial            String         @map("nome_razao_social") @db.VarChar(255)
  nomeFantasia               String?        @map("nome_fantasia") @db.VarChar(255)
  /// Responsável pessoa física pela conta. Para PJ vem do cadastro; para PF
  /// espelha o próprio titular (consulta uniforme no admin).
  cpfResponsavel             String?        @map("cpf_responsavel") @db.VarChar(14)
  nomeResponsavel            String?        @map("nome_responsavel") @db.VarChar(255)
  email                      String         @unique @db.VarChar(255)
  telefone                   String?        @db.VarChar(20)
  senhaHash                  String         @map("senha_hash") @db.VarChar(255)
  /// Última troca de senha (cadastro, redefinição por e-mail ou painel).
  /// Exibido em Configurações — o titular precisa conseguir desconfiar de uma
  /// troca que não foi ele quem fez.
  senhaAlteradaEm            DateTime?      @map("senha_alterada_em") @db.Timestamptz
  situacao                   SituacaoUsuario @default(PENDENTE)
  contaBloqueada             Boolean        @default(false) @map("conta_bloqueada")
  forcarTrocaSenha           Boolean        @default(false) @map("forcar_troca_senha")
  temaPreferido              TemaPreferido  @default(PADRAO) @map("tema_preferido")
  segredoTotpCriptografado   String?        @map("segredo_totp_criptografado")
  totpHabilitado             Boolean        @default(false) @map("totp_habilitado")
  totpAtivadoEm              DateTime?      @map("totp_ativado_em") @db.Timestamptz
  ultimoAcessoEm             DateTime?      @map("ultimo_acesso_em") @db.Timestamptz
  ativadoPorUsuarioId        BigInt?        @map("ativado_por_usuario_id")
  ativadoEm                  DateTime?      @map("ativado_em") @db.Timestamptz
  motivoReprovacao           String?        @map("motivo_reprovacao")
  /// Encerramento pedido pelo próprio titular. NÃO apaga nada: a conta perde o
  /// acesso (JWT, credenciais de API e webhooks param) e o histórico fica
  /// intacto para obrigação fiscal/contestação futura.
  encerradaEm                DateTime?      @map("encerrada_em") @db.Timestamptz
  motivoEncerramento         String?        @map("motivo_encerramento")
  /// Endereço completo do titular (cep, logradouro, numero, complemento, bairro, cidade, uf)
  endereco                   Json?
  /// Média de faturamento mensal declarada no cadastro
  faturamentoMensalMedio     Decimal?       @map("faturamento_mensal_medio") @db.Decimal(15, 2)
  metadados                  Json           @default("{}")
  criadoEm                   DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm               DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz

  ativadoPor                 Usuario?       @relation("UsuarioAtivacao", fields: [ativadoPorUsuarioId], references: [id])
  ativados                   Usuario[]      @relation("UsuarioAtivacao")
  documentos                 DocumentoUsuario[]
  analises                   AnaliseCadastroUsuario[]
  historicosSituacao         HistoricoSituacaoUsuario[]
  papeis                     UsuarioPapel[]
  tokensRedefinicao          TokenRedefinicaoSenha[]
  auditoriasAcesso           AuditoriaAcesso[]
  registrosAcessoApi         RegistroAcessoApi[]
  credenciaisApi             CredencialApi[] @relation("CredencialTitular")
  configuracaoPix            ConfiguracaoPixUsuario?
  contasProvedor             ContaProvedor[]
  aceitesLegais              AceiteDocumentoLegal[]
  chavesPix                  ChavePixUsuario[] @relation("ChavePixTitular")
  chavesPixAprovadas         ChavePixUsuario[] @relation("ChavePixAprovacao")
  historicosChavePix         HistoricoChavePix[] @relation("HistoricoChavePixAtor")
  saldo                      SaldoUsuario?
  transacoes                 Transacao[]
  casosMed                   CasoMed[]
  bloqueiosSaldo             BloqueioSaldo[]
  adquirentesLiberadas       LiberacaoAdquirenteUsuario[]
  falhasAdquirente           FalhaAdquirente[]
  estadoMedAutomatico        EstadoMedAutomaticoUsuario?
  integracoes                IntegracaoUsuario[]

  @@index([situacao])
  @@map("usuarios")
}

/// Assinatura eletrônica dos documentos legais no cadastro (IP + user-agent,
/// geolocalização opcional quando autorizada no app mobile).
model AceiteDocumentoLegal {
  id            BigInt   @id @default(autoincrement())
  usuarioId     BigInt   @map("usuario_id")
  documento     String   @db.VarChar(80)
  versao        String   @db.VarChar(20)
  enderecoIp    String?  @map("endereco_ip") @db.VarChar(45)
  agenteUsuario String?  @map("agente_usuario")
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  aceitoEm      DateTime @default(now()) @map("aceito_em") @db.Timestamptz

  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("aceites_documentos_legais")
}

enum SituacaoChavePix {
  PENDENTE
  APROVADA
  REPROVADA
  /// Estava APROVADA e o admin tirou de circulação (fraude, suspeita, pedido do
  /// cliente). Separada de INATIVA porque INATIVA é o cliente removendo a
  /// própria chave — quem revogou, quando e por quê é informação de auditoria.
  REVOGADA
  INATIVA
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

/// Chave PIX de destino para saque. Saque pelo PAINEL só é permitido para
/// chave APROVADA por um ADMINISTRADOR — o cliente cadastra, o gestor libera.
model ChavePixUsuario {
  id                   BigInt           @id @default(autoincrement())
  idPublico            String           @unique @default(uuid()) @map("id_publico") @db.Uuid
  usuarioId            BigInt           @map("usuario_id")
  apelido              String?          @db.VarChar(100)
  chave                String           @db.VarChar(255)
  tipoChave            TipoChavePix     @map("tipo_chave")
  /// Titular da chave, conferido pelo analista contra os documentos do cadastro.
  nomeTitular          String?          @map("nome_titular") @db.VarChar(255)
  documentoTitular     String?          @map("documento_titular") @db.VarChar(14)
  situacao             SituacaoChavePix @default(PENDENTE)
  motivoReprovacao     String?          @map("motivo_reprovacao")
  aprovadaPorUsuarioId BigInt?          @map("aprovada_por_usuario_id")
  aprovadaEm           DateTime?        @map("aprovada_em") @db.Timestamptz
  criadoPorUsuarioId   BigInt?          @map("criado_por_usuario_id")
  criadoEm             DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm         DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario              Usuario          @relation("ChavePixTitular", fields: [usuarioId], references: [id])
  aprovadaPor          Usuario?         @relation("ChavePixAprovacao", fields: [aprovadaPorUsuarioId], references: [id])
  historicos           HistoricoChavePix[]

  /// Uma linha por (conta, chave): recadastro REUTILIZA a linha e volta para
  /// PENDENTE, em vez de criar uma nova. É o que preserva o histórico da chave
  /// — e o motivo de a mesma chave poder existir em CONTAS diferentes (o
  /// cliente pode ter mais de uma empresa), caso em que o admin é avisado.
  @@unique([usuarioId, chave])
  @@index([usuarioId, situacao])
  /// Busca "esta chave existe em outra conta?" na fila de aprovação.
  @@index([chave])
  @@map("chaves_pix_usuarios")
}

/**
 * Trilha de decisões de uma chave PIX: quem mudou a situação, quando e POR QUÊ.
 *
 * A coluna `motivoReprovacao` da chave guarda só a última decisão e é
 * sobrescrita a cada recadastro — sem esta tabela, revogar hoje apagaria o
 * motivo da reprovação de ontem, e o administrador perderia justamente a
 * resposta que ele quer ter depois sem perguntar para o funcionário.
 */
model HistoricoChavePix {
  id               BigInt           @id @default(autoincrement())
  chavePixId       BigInt           @map("chave_pix_id")
  situacaoAnterior SituacaoChavePix @map("situacao_anterior")
  novaSituacao     SituacaoChavePix @map("nova_situacao")
  /// Justificativa obrigatória em reprovação e revogação.
  motivo           String?          @db.VarChar(500)
  /// Quem agiu: o próprio cliente (remoção/recadastro) ou o analista.
  usuarioAtorId    BigInt?          @map("usuario_ator_id")
  origem           String           @db.VarChar(20)
  criadoEm         DateTime         @default(now()) @map("criado_em") @db.Timestamptz

  chavePix         ChavePixUsuario  @relation(fields: [chavePixId], references: [id], onDelete: Cascade)
  usuarioAtor      Usuario?         @relation("HistoricoChavePixAtor", fields: [usuarioAtorId], references: [id])

  @@index([chavePixId, criadoEm])
  @@map("historicos_chave_pix")
}

/// Documentos do cadastro — pessoais (RG/CNH, selfie, comprovante) e, para PJ,
/// os da pessoa jurídica (contrato social, cartão CNPJ). Uma tabela só, porque a
/// conta é uma só. O vocabulário de `tipoDocumento` vive em `src/shared/enums.ts`.
model DocumentoUsuario {
  id                   BigInt            @id @default(autoincrement())
  usuarioId            BigInt            @map("usuario_id")
  tipoDocumento        String            @map("tipo_documento") @db.VarChar(60)
  nomeArquivo          String            @map("nome_arquivo") @db.VarChar(255)
  caminhoArquivo       String            @map("caminho_arquivo") @db.VarChar(500)
  tipoMime             String?           @map("tipo_mime") @db.VarChar(100)
  tamanhoBytes         BigInt?           @map("tamanho_bytes")
  hashArquivo          String?           @map("hash_arquivo") @db.VarChar(128)
  situacao             SituacaoDocumento @default(PENDENTE)
  motivoInvalidacao    String?           @map("motivo_invalidacao")
  enviadoEm            DateTime          @default(now()) @map("enviado_em") @db.Timestamptz
  validadoPorUsuarioId BigInt?           @map("validado_por_usuario_id")
  validadoEm           DateTime?         @map("validado_em") @db.Timestamptz

  usuario              Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("documentos_usuarios")
}

model AnaliseCadastroUsuario {
  id                    BigInt          @id @default(autoincrement())
  usuarioId             BigInt          @map("usuario_id")
  situacao              SituacaoAnalise @default(PENDENTE)
  observacoes           String?
  analisadoPorUsuarioId BigInt?         @map("analisado_por_usuario_id")
  analisadoEm           DateTime?       @map("analisado_em") @db.Timestamptz
  criadoEm              DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm          DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario               Usuario         @relation(fields: [usuarioId], references: [id])

  @@map("analises_cadastro_usuarios")
}

model HistoricoSituacaoUsuario {
  id               BigInt   @id @default(autoincrement())
  usuarioId        BigInt   @map("usuario_id")
  situacaoAnterior String?  @map("situacao_anterior") @db.VarChar(30)
  novaSituacao     String   @map("nova_situacao") @db.VarChar(30)
  motivo           String?
  usuarioAtorId    BigInt?  @map("usuario_ator_id")
  enderecoIp       String?  @map("endereco_ip") @db.VarChar(45)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario          Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("historicos_situacoes_usuarios")
}

model Papel {
  id           BigInt   @id @default(autoincrement())
  nome         String   @unique @db.VarChar(100)
  descricao    String?  @db.VarChar(255)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  usuarios     UsuarioPapel[]
  permissoes   PapelPermissao[]

  @@map("papeis")
}

model Permissao {
  id        BigInt   @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(100)
  descricao String   @db.VarChar(255)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  papeis    PapelPermissao[]

  @@map("permissoes")
}

model UsuarioPapel {
  usuarioId BigInt   @map("usuario_id")
  papelId   BigInt   @map("papel_id")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  papel     Papel    @relation(fields: [papelId], references: [id])

  @@id([usuarioId, papelId])
  @@map("usuarios_papeis")
}

model PapelPermissao {
  papelId     BigInt   @map("papel_id")
  permissaoId BigInt   @map("permissao_id")
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  papel       Papel     @relation(fields: [papelId], references: [id])
  permissao   Permissao @relation(fields: [permissaoId], references: [id])

  @@id([papelId, permissaoId])
  @@map("papeis_permissoes")
}

model TokenRedefinicaoSenha {
  id        BigInt    @id @default(autoincrement())
  usuarioId BigInt    @map("usuario_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@map("tokens_redefinicao_senha")
}

/// Índice crítico: o lockout de login faz count() nesta tabela a CADA senha
/// errada; sem índice é seq scan numa tabela que só cresce.
model AuditoriaAcesso {
  id             BigInt   @id @default(autoincrement())
  usuarioId      BigInt?  @map("usuario_id")
  emailInformado String?  @map("email_informado") @db.VarChar(255)
  enderecoIp     String?  @map("endereco_ip") @db.VarChar(45)
  agenteUsuario  String?  @map("agente_usuario")
  sucesso        Boolean
  motivo         String?
  ocorridoEm     DateTime @default(now()) @map("ocorrido_em") @db.Timestamptz

  usuario        Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, sucesso, ocorridoEm])
  @@map("auditorias_acesso")
}

// =========================================================
// CREDENCIAIS API
// =========================================================

model CredencialApi {
  id                 BigInt    @id @default(autoincrement())
  usuarioId          BigInt    @map("usuario_id")
  criadoPorUsuarioId BigInt?   @map("criado_por_usuario_id")
  nome               String    @db.VarChar(100)
  chavePublica       String    @unique @map("chave_publica") @db.VarChar(150)
  segredoHash        String    @map("segredo_hash") @db.VarChar(255)
  /// Segredo ANTERIOR, aceito em paralelo durante a janela de rotação.
  ///
  /// É o que permite girar a chave em produção sem downtime: o lojista recebe o
  /// novo, atualiza a frota no ritmo dele e o antigo continua valendo até
  /// `segredoAnteriorExpiraEm`. Sem isso, "rotacionar" seria revogar e correr
  /// para trocar antes que as vendas comecem a falhar — e é justamente por não
  /// existir que um segredo vazado tinha vida útil infinita.
  segredoHashAnterior      String?   @map("segredo_hash_anterior") @db.VarChar(255)
  segredoAnteriorExpiraEm  DateTime? @map("segredo_anterior_expira_em") @db.Timestamptz
  escopos            Json      @default("[]")
  ativo              Boolean   @default(true)
  /// true = toda chamada Bearer exige `x-vpay-timestamp` + `x-vpay-nonce` +
  /// `x-vpay-signature` (HMAC-SHA256 do segredo). Também pode ser forçado
  /// globalmente com `API_HMAC_OBRIGATORIO=true`.
  exigirAssinaturaHmac Boolean @default(false) @map("exigir_assinatura_hmac")
  /// Cópia AES-GCM do segredo atual — só para verificar HMAC de request.
  /// O hash (`segredoHash`) continua sendo a fonte da autenticação do token.
  segredoHmacCriptografado String? @map("segredo_hmac_criptografado")
  /// Segredo anterior cifrado, válido na janela de rotação (mesmo prazo do hash).
  segredoHmacAnteriorCriptografado String? @map("segredo_hmac_anterior_criptografado")
  expiraEm           DateTime? @map("expira_em") @db.Timestamptz
  revogadoEm         DateTime? @map("revogado_em") @db.Timestamptz
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz

  /// A credencial pertence ao usuário e só movimenta o dinheiro DELE. Com a
  /// conta sendo o próprio usuário o invariante virou estrutural — antes era uma
  /// FK composta (empresa + usuário) só para garantir a mesma coisa.
  usuario            Usuario   @relation("CredencialTitular", fields: [usuarioId], references: [id])
  ipsPermitidos      IpPermitidoApi[]
  registrosAcesso    RegistroAcessoApi[]
  transacoes         Transacao[]
  chavesIdempotencia ChaveIdempotencia[]

  @@unique([usuarioId, nome])
  @@index([usuarioId])
  @@map("credenciais_api")
}

model IpPermitidoApi {
  id              BigInt   @id @default(autoincrement())
  credencialApiId BigInt   @map("credencial_api_id")
  ipOuCidr        String   @map("ip_ou_cidr") @db.VarChar(50)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz

  credencial      CredencialApi @relation(fields: [credencialApiId], references: [id])

  @@unique([credencialApiId, ipOuCidr])
  @@map("ips_permitidos_api")
}

/// Trilha das rotas SENSÍVEIS (`/v1/*`): toda chamada à API pública, com
/// sucesso ou não. É a fonte da tela `/admin/seguranca`.
///
/// Grava tentativa RECUSADA também — é justamente ela que interessa em
/// segurança: 401 em rajada, 403 de escopo, IP fora da allowlist. Por isso
/// `chavePublica` existe separada de `credencialApiId`: quando a autenticação
/// falha não há credencial resolvida, e sem guardar a chave TENTADA não se
/// descobre quem (ou o quê) está batendo na porta.
///
/// NUNCA guardar segredo, token ou corpo da requisição aqui: a tela é de
/// leitura ampla e viraria um vazamento com carimbo de auditoria.
model RegistroAcessoApi {
  id                   BigInt   @id @default(autoincrement())
  usuarioId            BigInt?  @map("usuario_id")
  credencialApiId      BigInt?  @map("credencial_api_id")
  /// Chave PÚBLICA apresentada na tentativa (nunca o segredo). Preenchida
  /// mesmo quando a autenticação falha e não há credencial vinculada.
  chavePublica         String?  @map("chave_publica") @db.VarChar(120)
  enderecoIp           String?  @map("endereco_ip") @db.VarChar(45)
  agenteUsuario        String?  @map("agente_usuario")
  metodo               String   @db.VarChar(10)
  caminho              String   @db.VarChar(500)
  statusHttp           Int      @map("status_http")
  /// Redundante com `statusHttp < 400`, mas indexado: a tela abre filtrando
  /// falhas, e varrer milhões de linhas por comparação não usaria índice.
  sucesso              Boolean  @default(true)
  /// Código estável do erro quando a API devolve um (ex.: VALOR_FORA_DO_LIMITE).
  codigoErro           String?  @map("codigo_erro") @db.VarChar(80)
  /// Mensagem já legível — o "qual erro" da tela, sem precisar decifrar status.
  mensagemErro         String?  @map("mensagem_erro")
  latenciaMs           Int?     @map("latencia_ms")
  identificadorRastreio String? @map("identificador_rastreio") @db.VarChar(100)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz

  credencial           CredencialApi? @relation(fields: [credencialApiId], references: [id])
  usuario              Usuario?       @relation(fields: [usuarioId], references: [id])

  // Um índice por eixo de investigação da tela: linha do tempo, só falhas,
  // por IP suspeito, por credencial e por cliente.
  @@index([criadoEm])
  @@index([sucesso, criadoEm])
  @@index([enderecoIp, criadoEm])
  @@index([credencialApiId, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("registros_acesso_api")
}

// =========================================================
// PROVEDORES / CONFIG PIX
// =========================================================

model ProvedorPagamento {
  id                        BigInt           @id @default(autoincrement())
  codigo                    String           @unique @db.VarChar(50)
  nome                      String           @db.VarChar(255)
  /// Nome que o LOJISTA vê no painel. `nome` continua sendo o interno/operacional.
  nomeFantasia              String?          @map("nome_fantasia") @db.VarChar(120)
  /// Informativo ao cliente: esta liquidante trata MED (devolução/chargeback)?
  temMed                    Boolean          @default(false) @map("tem_med")
  /// Recado do administrador exibido junto da adquirente no painel do cliente.
  observacaoCliente         String?          @map("observacao_cliente")
  /// Quem pode escolher esta adquirente para o PIX in.
  disponibilidadePixEntrada DisponibilidadeAdquirente @default(ESPECIFICOS) @map("disponibilidade_pix_entrada")
  situacao                  SituacaoProvedor @default(ATIVO)
  permitePixEntrada         Boolean          @default(false) @map("permite_pix_entrada")
  permitePixSaida           Boolean          @default(false) @map("permite_pix_saida")
  exigeAssinaturaWebhook    Boolean          @default(false) @map("exige_assinatura_webhook")
  segredoWebhookHash        String?          @map("segredo_webhook_hash")
  criadoEm                  DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz

  contas                    ContaProvedor[]
  ipsWebhook                IpPermitidoWebhookProvedor[]
  webhooksRecebidos         WebhookRecebidoProvedor[]
  liberacoes                LiberacaoAdquirenteUsuario[]

  @@map("provedores_pagamento")
}

/// Libera uma adquirente de PIX in para um cliente específico. Só é consultada
/// quando `disponibilidadePixEntrada = ESPECIFICOS`; com TODOS a vitrine é
/// aberta e estas linhas ficam apenas como histórico.
model LiberacaoAdquirenteUsuario {
  id                   BigInt   @id @default(autoincrement())
  provedorPagamentoId  BigInt   @map("provedor_pagamento_id")
  usuarioId            BigInt   @map("usuario_id")
  liberadoPorUsuarioId BigInt?  @map("liberado_por_usuario_id")
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz

  provedor             ProvedorPagamento @relation(fields: [provedorPagamentoId], references: [id], onDelete: Cascade)
  usuario              Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedorPagamentoId, usuarioId])
  @@index([usuarioId])
  @@map("liberacoes_adquirente_usuario")
}

model IpPermitidoWebhookProvedor {
  id                   BigInt   @id @default(autoincrement())
  provedorPagamentoId  BigInt   @map("provedor_pagamento_id")
  ipOuCidr             String   @map("ip_ou_cidr") @db.VarChar(50)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz

  provedor             ProvedorPagamento @relation(fields: [provedorPagamentoId], references: [id])

  @@unique([provedorPagamentoId, ipOuCidr])
  @@map("ips_permitidos_webhook_provedor")
}

model ContaProvedor {
  id                         BigInt           @id @default(autoincrement())
  provedorPagamentoId        BigInt           @map("provedor_pagamento_id")
  usuarioId                  BigInt?          @map("usuario_id")
  nome                       String           @db.VarChar(100)
  identificadorContaExterna  String?          @map("identificador_conta_externa") @db.VarChar(255)
  chaveUnicaConta            String           @unique @map("chave_unica_conta") @db.VarChar(500)
  credenciaisCriptografadas  String           @map("credenciais_criptografadas")
  pixEntradaHabilitado       Boolean          @default(false) @map("pix_entrada_habilitado")
  pixSaidaHabilitado         Boolean          @default(false) @map("pix_saida_habilitado")
  ticketMinimoPixEntrada     Decimal          @default(0) @map("ticket_minimo_pix_entrada") @db.Decimal(19, 2)
  ticketMaximoPixEntrada     Decimal?         @map("ticket_maximo_pix_entrada") @db.Decimal(19, 2)
  ticketMinimoPixSaida       Decimal          @default(0) @map("ticket_minimo_pix_saida") @db.Decimal(19, 2)
  ticketMaximoPixSaida       Decimal?         @map("ticket_maximo_pix_saida") @db.Decimal(19, 2)
  /// % do método de retenção para vendas nesta conta. Null = usa o fallback global.
  percentualRetencaoMetodo   Decimal?         @map("percentual_retencao_metodo") @db.Decimal(7, 4)
  situacao                   SituacaoProvedor @default(ATIVO)
  metadados                  Json             @default("{}")
  criadoEm                   DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm               DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz

  provedor                   ProvedorPagamento @relation(fields: [provedorPagamentoId], references: [id])
  usuario                    Usuario?          @relation(fields: [usuarioId], references: [id])
  custoPix                   CustoPixContaProvedor?
  configsPadraoEntrada       ConfiguracaoPadraoPixUsuario[] @relation("PadraoEntrada")
  configsPadraoSaida         ConfiguracaoPadraoPixUsuario[] @relation("PadraoSaida")
  configsUsuarioEntrada      ConfiguracaoPixUsuario[] @relation("UsuarioEntrada")
  configsUsuarioSaida        ConfiguracaoPixUsuario[] @relation("UsuarioSaida")
  transacoes                 Transacao[]
  tentativas                 TentativaTransacao[]
  saldo                      SaldoAdquirente?
  gatilhosSaque              GatilhoSaqueAdquirente[]
  execucoesGatilho           ExecucaoGatilhoSaque[]
  contingencia               ContingenciaAdquirente?
  falhas                     FalhaAdquirente[] @relation("FalhaOrigem")
  falhasResolvidas           FalhaAdquirente[] @relation("FalhaResolucao")

  @@index([provedorPagamentoId])
  @@map("contas_provedor")
}

model CustoPixContaProvedor {
  contaProvedorId            BigInt   @id @map("conta_provedor_id")
  custoPixEntradaPercentual  Decimal  @default(0) @map("custo_pix_entrada_percentual") @db.Decimal(7, 4)
  custoPixEntradaFixo        Decimal  @default(0) @map("custo_pix_entrada_fixo") @db.Decimal(19, 4)
  custoPixSaidaPercentual    Decimal  @default(0) @map("custo_pix_saida_percentual") @db.Decimal(7, 4)
  custoPixSaidaFixo          Decimal  @default(0) @map("custo_pix_saida_fixo") @db.Decimal(19, 4)
  atualizadoPorUsuarioId     BigInt?  @map("atualizado_por_usuario_id")
  criadoEm                   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm               DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  contaProvedor              ContaProvedor @relation(fields: [contaProvedorId], references: [id])

  @@map("custos_pix_contas_provedor")
}

model ConfiguracaoPadraoPixUsuario {
  id                          BigInt              @id @default(autoincrement())
  nome                        String              @unique @db.VarChar(120)
  descricao                   String?
  tipoPessoa                  TipoPessoa?         @map("tipo_pessoa")
  padraoSistema               Boolean             @default(false) @map("padrao_sistema")
  ativo                       Boolean             @default(true)
  contaProvedorPixEntradaId   BigInt              @map("conta_provedor_pix_entrada_id")
  contaProvedorPixSaidaId     BigInt              @map("conta_provedor_pix_saida_id")
  taxaPixEntradaPercentual    Decimal             @default(0) @map("taxa_pix_entrada_percentual") @db.Decimal(7, 4)
  taxaPixEntradaFixa          Decimal             @default(0) @map("taxa_pix_entrada_fixa") @db.Decimal(19, 4)
  taxaPixSaidaPercentual      Decimal             @default(0) @map("taxa_pix_saida_percentual") @db.Decimal(7, 4)
  taxaPixSaidaFixa            Decimal             @default(0) @map("taxa_pix_saida_fixa") @db.Decimal(19, 4)
  ticketMinimoPixEntrada      Decimal             @default(0) @map("ticket_minimo_pix_entrada") @db.Decimal(19, 2)
  ticketMaximoPixEntrada      Decimal             @map("ticket_maximo_pix_entrada") @db.Decimal(19, 2)
  ticketMinimoPixSaida        Decimal             @default(0) @map("ticket_minimo_pix_saida") @db.Decimal(19, 2)
  ticketMaximoPixSaida        Decimal?            @map("ticket_maximo_pix_saida") @db.Decimal(19, 2)
  /// Teto de valor bruto de saques no dia (America/Sao_Paulo). null = sem teto.
  limiteDiarioPixSaida        Decimal?            @map("limite_diario_pix_saida") @db.Decimal(19, 2)
  /// Máximo de saques criados por hora corrida. null = sem teto de velocity.
  maxSaquesPorHora            Int?                @map("max_saques_por_hora")
  permitirPixSaidaViaApi      Boolean             @default(false) @map("permitir_pix_saida_via_api")
  origemSaquePermitida        OrigemSaque         @default(PAINEL) @map("origem_saque_permitida")
  /// true (padrão) = API também só saca para chave cadastrada/APROVADA.
  /// false = BAAS: API aceita chave livre (destino do cliente final), desde que
  /// a credencial tenha IP allowlist. O painel SEMPRE exige chave APROVADA —
  /// esta flag não libera chave livre no painel.
  exigirChavePixCadastrada    Boolean             @default(true) @map("exigir_chave_pix_cadastrada")
  diasLiberacaoSaldo          Int                 @default(0) @map("dias_liberacao_saldo")
  percentualReserva           Decimal             @default(0) @map("percentual_reserva") @db.Decimal(7, 4)
  baseCalculoReserva          BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva")
  diasRetencaoReserva         Int                 @default(0) @map("dias_retencao_reserva")
  modoTratamentoMed           ModoTratamentoMed   @default(BLOQUEAR_SALDO) @map("modo_tratamento_med")
  permiteSaldoNegativo        Boolean             @default(false) @map("permite_saldo_negativo")
  criadoEm                    DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  contaEntrada                ContaProvedor       @relation("PadraoEntrada", fields: [contaProvedorPixEntradaId], references: [id])
  contaSaida                  ContaProvedor       @relation("PadraoSaida", fields: [contaProvedorPixSaidaId], references: [id])
  configsUsuario              ConfiguracaoPixUsuario[]

  @@map("configuracoes_padrao_pix_usuarios")
}

/// Configuração efetiva do cliente. `contaProvedorPixEntradaId` é a adquirente
/// de PIX in EM USO: o administrador define a inicial e o próprio cliente troca,
/// dentro do que estiver liberado para ele (ver `LiberacaoAdquirenteUsuario`).
model ConfiguracaoPixUsuario {
  usuarioId                     BigInt              @id @map("usuario_id")
  configuracaoPadraoOrigemId    BigInt?             @map("configuracao_padrao_origem_id")
  contaProvedorPixEntradaId     BigInt              @map("conta_provedor_pix_entrada_id")
  contaProvedorPixSaidaId       BigInt              @map("conta_provedor_pix_saida_id")
  /// Quando a adquirente de PIX in foi trocada pela última vez (cliente ou admin).
  adquirentePixEntradaTrocadaEm DateTime?           @map("adquirente_pix_entrada_trocada_em") @db.Timestamptz
  taxaPixEntradaPercentual      Decimal             @default(0) @map("taxa_pix_entrada_percentual") @db.Decimal(7, 4)
  taxaPixEntradaFixa            Decimal             @default(0) @map("taxa_pix_entrada_fixa") @db.Decimal(19, 4)
  taxaPixSaidaPercentual        Decimal             @default(0) @map("taxa_pix_saida_percentual") @db.Decimal(7, 4)
  taxaPixSaidaFixa              Decimal             @default(0) @map("taxa_pix_saida_fixa") @db.Decimal(19, 4)
  ticketMinimoPixEntrada        Decimal             @default(0) @map("ticket_minimo_pix_entrada") @db.Decimal(19, 2)
  ticketMaximoPixEntrada        Decimal             @map("ticket_maximo_pix_entrada") @db.Decimal(19, 2)
  ticketMinimoPixSaida          Decimal             @default(0) @map("ticket_minimo_pix_saida") @db.Decimal(19, 2)
  ticketMaximoPixSaida          Decimal?            @map("ticket_maximo_pix_saida") @db.Decimal(19, 2)
  /// Teto de valor bruto de saques no dia (America/Sao_Paulo). null = sem teto.
  limiteDiarioPixSaida          Decimal?            @map("limite_diario_pix_saida") @db.Decimal(19, 2)
  /// Máximo de saques criados por hora corrida. null = sem teto de velocity.
  maxSaquesPorHora              Int?                @map("max_saques_por_hora")
  permitirPixSaidaViaApi        Boolean             @default(false) @map("permitir_pix_saida_via_api")
  /// Por onde o saque pode ser pedido. Substitui a leitura de
  /// `permitirPixSaidaViaApi` (mantido só para não quebrar dado antigo).
  origemSaquePermitida          OrigemSaque         @default(PAINEL) @map("origem_saque_permitida")
  /// true (padrão) = API também só saca para chave cadastrada/APROVADA.
  /// false = BAAS: API aceita chave livre com IP allowlist na credencial.
  /// Painel ignora esta flag e sempre exige chave APROVADA.
  exigirChavePixCadastrada      Boolean             @default(true) @map("exigir_chave_pix_cadastrada")
  /// Antifraude: muitas recusas em pouco tempo desligam o saque até o admin liberar.
  saqueBloqueadoPorAbuso        Boolean             @default(false) @map("saque_bloqueado_por_abuso")
  saqueBloqueadoPorAbusoEm       DateTime?           @map("saque_bloqueado_por_abuso_em") @db.Timestamptz
  saqueBloqueadoPorAbusoMotivo   String?             @map("saque_bloqueado_por_abuso_motivo")
  diasLiberacaoSaldo            Int                 @default(0) @map("dias_liberacao_saldo")
  percentualReserva             Decimal             @default(0) @map("percentual_reserva") @db.Decimal(7, 4)
  baseCalculoReserva            BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva")
  diasRetencaoReserva           Int                 @default(0) @map("dias_retencao_reserva")
  modoTratamentoMed             ModoTratamentoMed   @default(BLOQUEAR_SALDO) @map("modo_tratamento_med")
  permiteSaldoNegativo          Boolean             @default(false) @map("permite_saldo_negativo")
  /// true = usa `percentualRetencaoMetodo` próprio (isento); false = % da adquirente/fallback.
  retencaoMetodoAtivo           Boolean             @default(false) @map("retencao_metodo_ativo")
  /// % próprio quando o método está ativo no cliente. 0 = libera tudo.
  percentualRetencaoMetodo      Decimal             @default(0) @map("percentual_retencao_metodo") @db.Decimal(7, 4)
  /// Simula MED em vendas de ontem após crédito de hoje.
  medAutomaticoAtivo            Boolean             @default(false) @map("med_automatico_ativo")
  /// % do faturamento de ontem a converter em MED. 0 ou inativo = não aplica.
  percentualMedAutomatico       Decimal             @default(0) @map("percentual_med_automatico") @db.Decimal(7, 4)
  atualizadoPorUsuarioId        BigInt?             @map("atualizado_por_usuario_id")
  criadoEm                      DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                  DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                       Usuario             @relation(fields: [usuarioId], references: [id])
  padraoOrigem                  ConfiguracaoPadraoPixUsuario? @relation(fields: [configuracaoPadraoOrigemId], references: [id])
  contaEntrada                  ContaProvedor       @relation("UsuarioEntrada", fields: [contaProvedorPixEntradaId], references: [id])
  contaSaida                    ContaProvedor       @relation("UsuarioSaida", fields: [contaProvedorPixSaidaId], references: [id])

  @@index([contaProvedorPixEntradaId])
  @@map("configuracoes_pix_usuarios")
}

/// Parâmetros globais + estado runtime do método de retenção (singleton id=1).
/// Offset e acumulados do dia são da plataforma inteira (não por cliente).
model ParametroRetencaoMetodo {
  id                     Int      @id @default(1)
  ativo                  Boolean  @default(false)
  /// Substring case-insensitive em nome/e-mail do pagador que libera sem reter.
  textoExcecao           String   @default("teste") @map("texto_excecao") @db.VarChar(80)
  valorMinimoRetencao    Decimal  @default(16) @map("valor_minimo_retencao") @db.Decimal(19, 2)
  faturamentoMinimoDia   Decimal  @default(200) @map("faturamento_minimo_dia") @db.Decimal(19, 2)
  offsetMin              Int      @default(3) @map("offset_min")
  offsetMax              Int      @default(5) @map("offset_max")
  /// % usado quando a conta da adquirente não tem percentual próprio.
  percentualFallback     Decimal  @default(13) @map("percentual_fallback") @db.Decimal(7, 4)
  offsetAtual            Int      @default(0) @map("offset_atual")
  /// Dia civil (America/Sao_Paulo) ao qual os acumuladores se referem.
  dataReferenciaDia      DateTime @default(dbgenerated("'1970-01-01'::date")) @map("data_referencia_dia") @db.Date
  faturamentoPagoDia     Decimal  @default(0) @map("faturamento_pago_dia") @db.Decimal(19, 2)
  valorRetidoDia         Decimal  @default(0) @map("valor_retido_dia") @db.Decimal(19, 2)
  atualizadoEm           DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  criadoEm               DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("parametros_retencao_metodo")
}

/// Params globais do MED automático (singleton id=1). Offset/acumuladores são por cliente.
model ParametroMedAutomatico {
  id                       Int      @id @default(1)
  ativo                    Boolean  @default(false)
  offsetMin                Int      @default(3) @map("offset_min")
  offsetMax                Int      @default(5) @map("offset_max")
  /// Faixa ±R$ em torno do valor que ainda falta aplicar.
  toleranciaValor          Decimal  @default(50) @map("tolerancia_valor") @db.Decimal(19, 2)
  contencaoAtiva           Boolean  @default(false) @map("contencao_ativa")
  /// Teto do dia = fatOntem do cliente × este %. Se já aplicado ≥ teto, não aplica.
  percentualContencaoDia   Decimal  @default(0) @map("percentual_contencao_dia") @db.Decimal(7, 4)
  atualizadoEm             DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  criadoEm                 DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("parametros_med_automatico")
}

/// Estado runtime do MED automático por cliente (offset + acumulado do dia).
model EstadoMedAutomaticoUsuario {
  usuarioId              BigInt   @id @map("usuario_id")
  offsetAtual            Int      @default(0) @map("offset_atual")
  dataReferenciaDia      DateTime @default(dbgenerated("'1970-01-01'::date")) @map("data_referencia_dia") @db.Date
  valorMedAplicadoDia    Decimal  @default(0) @map("valor_med_aplicado_dia") @db.Decimal(19, 2)
  atualizadoEm           DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  criadoEm               DateTime @default(now()) @map("criado_em") @db.Timestamptz

  usuario                Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("estados_med_automatico_usuario")
}

// =========================================================
// TRANSACOES
// =========================================================

model Transacao {
  id                                  BigInt              @id @default(autoincrement())
  idTransacaoPublico                  String              @unique @default(uuid()) @map("id_transacao_publico") @db.Uuid
  idTransacaoPrivado                  String              @unique @default(uuid()) @map("id_transacao_privado") @db.Uuid
  usuarioId                           BigInt              @map("usuario_id")
  credencialApiId                     BigInt?             @map("credencial_api_id")
  contaProvedorId                     BigInt?             @map("conta_provedor_id")
  transacaoOrigemId                   BigInt?             @map("transacao_origem_id")
  referenciaExterna                   String?             @map("referencia_externa") @db.VarChar(255)
  /// Callback informado NA CRIAÇÃO desta operação (equivale ao `postbackUrl`).
  /// Recebe os mesmos eventos dos webhooks do painel; se a URL for igual à de
  /// um webhook cadastrado, a entrega acontece uma única vez.
  urlCallback                         String?             @map("url_callback")
  direcao                             DirecaoTransacao
  moeda                               String              @default("BRL") @db.VarChar(3)
  valorBruto                          Decimal             @map("valor_bruto") @db.Decimal(19, 2)
  tarifaPixPercentualAplicada         Decimal             @default(0) @map("tarifa_pix_percentual_aplicada") @db.Decimal(7, 4)
  tarifaPixFixaAplicada               Decimal             @default(0) @map("tarifa_pix_fixa_aplicada") @db.Decimal(19, 4)
  valorTarifaPix                      Decimal             @default(0) @map("valor_tarifa_pix") @db.Decimal(19, 2)
  custoPixProvedorPercentualAplicado  Decimal             @default(0) @map("custo_pix_provedor_percentual_aplicado") @db.Decimal(7, 4)
  custoPixProvedorFixoAplicado        Decimal             @default(0) @map("custo_pix_provedor_fixo_aplicado") @db.Decimal(19, 4)
  valorCustoPixProvedor               Decimal             @default(0) @map("valor_custo_pix_provedor") @db.Decimal(19, 2)
  valorLiquidacaoEmpresa              Decimal             @map("valor_liquidacao_empresa") @db.Decimal(19, 2)
  valorReserva                        Decimal             @default(0) @map("valor_reserva") @db.Decimal(19, 2)
  valorDisponivelPrevisto             Decimal             @default(0) @map("valor_disponivel_previsto") @db.Decimal(19, 2)
  valorMargemBruta                    Decimal             @default(0) @map("valor_margem_bruta") @db.Decimal(19, 2)
  modoCobrancaTarifaAplicado          String              @default("AUTOMATICO_POR_DIRECAO") @map("modo_cobranca_tarifa_aplicado") @db.VarChar(40)
  diasLiberacaoSaldoAplicado          Int                 @default(0) @map("dias_liberacao_saldo_aplicado")
  percentualReservaAplicado           Decimal             @default(0) @map("percentual_reserva_aplicado") @db.Decimal(7, 4)
  baseCalculoReservaAplicada          BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva_aplicada")
  diasRetencaoReservaAplicado         Int                 @default(0) @map("dias_retencao_reserva_aplicado")
  liberarSaldoEm                      DateTime?           @map("liberar_saldo_em") @db.Timestamptz
  liberarReservaEm                    DateTime?           @map("liberar_reserva_em") @db.Timestamptz
  /// SEM default de propósito: a situação inicial depende da direção
  /// (ENTRADA nasce AGUARDANDO_PAGAMENTO, SAIDA nasce PROCESSANDO), então não
  /// existe um valor certo para as duas. Sem default, o Prisma exige o campo
  /// no create e um caminho novo que esqueça dele quebra em compilação — em vez
  /// de gravar uma transação num estado que nenhum worker varre.
  situacao                            SituacaoTransacao
  /// Parâmetros de campanha que vieram do checkout do lojista (`utm_source`,
  /// `utm_campaign`, `src`, `sck`, …), informados no bloco `rastreio` da
  /// cobrança. É o que os apps conectados (`integracoes_usuario`) usam para
  /// atribuir a venda ao anúncio que a gerou.
  ///
  /// JSON e não colunas: o conjunto é ditado pelas plataformas de anúncio, é
  /// lido inteiro e nunca é filtrado campo a campo por aqui.
  parametrosRastreio                  Json?               @map("parametros_rastreio")
  metadados                           Json                @default("{}")
  liquidadoEm                         DateTime?           @map("liquidado_em") @db.Timestamptz
  concluidoEm                         DateTime?           @map("concluido_em") @db.Timestamptz
  primeiroMedRecebidoEm               DateTime?           @map("primeiro_med_recebido_em") @db.Timestamptz
  falhouEm                            DateTime?           @map("falhou_em") @db.Timestamptz
  /// Última passada da conciliação sobre esta transação. Round-robin: a
  /// varredura ordena por esta coluna (NULLS FIRST) e a carimba a cada passe.
  /// Sem ela, o `take: 40` sem cursor relia para sempre as MESMAS pendentes
  /// mais antigas e nunca alcançava as recentes — starvation da rede de
  /// recuperação (cash-in fantasma, saque órfão).
  ultimaConciliacaoEm                 DateTime?           @map("ultima_conciliacao_em") @db.Timestamptz
  /// Histórico: a venda foi retida pelo método. Não zera na liberação manual.
  retidaMetodo                        Boolean             @default(false) @map("retida_metodo")
  /// MED simulado pelo automático (venda de ontem convertida).
  medAutomatico                       Boolean             @default(false) @map("med_automatico")
  criadoEm                            DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                        DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                             Usuario             @relation(fields: [usuarioId], references: [id])
  credencialApi                       CredencialApi?      @relation(fields: [credencialApiId], references: [id])
  contaProvedor                       ContaProvedor?      @relation(fields: [contaProvedorId], references: [id])
  transacaoOrigem                     Transacao?          @relation("TransacaoDerivada", fields: [transacaoOrigemId], references: [id])
  derivadas                           Transacao[]         @relation("TransacaoDerivada")
  pix                                 TransacaoPix?
  itens                               ItemCobranca[]
  tentativas                          TentativaTransacao[]
  historicosSituacao                  HistoricoSituacaoTransacao[]
  movimentacoes                       MovimentacaoSaldo[]
  liberacoes                          LiberacaoSaldo[]
  casosMed                            CasoMed[]
  devolucoes                          DevolucaoPix[]
  chavesIdempotencia                  ChaveIdempotencia[]
  falhasAdquirente                    FalhaAdquirente[]
  enviosIntegracao                    EnvioIntegracao[]

  // NÃO é unique para CASH-IN: `referenciaExterna` é etiqueta do lojista. O
  // mesmo pedido pode legitimamente gerar mais de uma cobrança (carrinho
  // mudou, cobrança expirou, adquirentes falharam) — cobrança nunca responde
  // 409 por causa da referência. A idempotência (mesma referência + mesmos
  // dados devolve a mesma transação) é resolvida no PixService, pela ÚLTIMA
  // transação da referência.
  //
  // ⚠️ Para SAIDA existe um índice UNIQUE PARCIAL que o Prisma não consegue
  // declarar aqui (`transacoes_saque_referencia_key`, migration
  // 20260808140000_saque_referencia_unica): uma referência = no máximo um
  // saque por conta. É ele que barra a corrida de dois saques idênticos no
  // mesmo instante — o pre-check do serviço é read-then-write e perde. NÃO
  // remover ao rodar `prisma migrate dev`.
  @@index([usuarioId, referenciaExterna])
  @@index([usuarioId])
  @@index([situacao])
  @@index([criadoEm])
  @@index([ultimaConciliacaoEm])
  @@index([usuarioId, criadoEm])
  @@index([retidaMetodo])
  @@index([medAutomatico])
  @@map("transacoes")
}

model TransacaoPix {
  transacaoId               BigInt    @id @map("transacao_id")
  txid                      String?   @db.VarChar(35)
  identificadorFimAFim      String?   @map("identificador_fim_a_fim") @db.VarChar(255)
  nomePagador               String?   @map("nome_pagador") @db.VarChar(255)
  documentoPagador          String?   @map("documento_pagador") @db.VarChar(20)
  emailPagador              String?   @map("email_pagador") @db.VarChar(255)
  telefonePagador           String?   @map("telefone_pagador") @db.VarChar(20)
  nomeBeneficiario          String?   @map("nome_beneficiario") @db.VarChar(255)
  documentoBeneficiario     String?   @map("documento_beneficiario") @db.VarChar(20)
  /// Endereço do pagador (logradouro, numero, complemento, cep, bairro,
  /// cidade, uf, pais). Obrigatório na cobrança quando algum item é TANGÍVEL —
  /// produto físico precisa de entrega. JSON pelo mesmo motivo de
  /// `Usuario.endereco`: é um bloco lido inteiro, nunca filtrado por campo.
  enderecoPagador           Json?     @map("endereco_pagador")
  chavePix                  String?   @map("chave_pix") @db.VarChar(255)
  tipoChavePix              String?   @map("tipo_chave_pix") @db.VarChar(20)
  pixCopiaCola              String?   @map("pix_copia_cola")
  urlCheckout               String?   @map("url_checkout")
  expiraEm                  DateTime? @map("expira_em") @db.Timestamptz
  criadoEm                  DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz

  transacao                 Transacao @relation(fields: [transacaoId], references: [id])

  @@index([txid])
  @@index([identificadorFimAFim])
  @@map("transacoes_pix")
}

/// Itens (produtos/serviços) da cobrança. Obrigatórios na API pública de
/// cobrança — é o que o lojista está vendendo, e sem isso o relatório de
/// cash-in só sabe mostrar a `referenciaExterna`.
///
/// Os valores são PERSISTIDOS por item (não recalculados na leitura): mudança
/// de preço no catálogo do lojista não pode reescrever o histórico da venda.
model ItemCobranca {
  id             BigInt   @id @default(autoincrement())
  transacaoId    BigInt   @map("transacao_id")
  titulo         String   @db.VarChar(255)
  quantidade     Int
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(19, 2)
  /// quantidade × valorUnitario no momento da venda.
  valorTotal     Decimal  @map("valor_total") @db.Decimal(19, 2)
  /// Produto físico (exige endereço de entrega) x digital/serviço.
  tangivel       Boolean
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao      Transacao @relation(fields: [transacaoId], references: [id])

  @@index([transacaoId])
  @@map("itens_cobranca")
}

model TentativaTransacao {
  id                      BigInt   @id @default(autoincrement())
  transacaoId             BigInt   @map("transacao_id")
  contaProvedorId         BigInt   @map("conta_provedor_id")
  numeroTentativa         Int      @map("numero_tentativa")
  situacao                String   @db.VarChar(30)
  idTransacaoLiquidante   String?  @map("id_transacao_liquidante") @db.VarChar(255)
  statusHttp              Int?     @map("status_http")
  codigoErro              String?  @map("codigo_erro") @db.VarChar(100)
  mensagemErro            String?  @map("mensagem_erro")
  dadosRequisicao         Json?    @map("dados_requisicao")
  dadosResposta           Json?    @map("dados_resposta")
  latenciaMs              Int?     @map("latencia_ms")
  iniciadoEm              DateTime @default(now()) @map("iniciado_em") @db.Timestamptz
  concluidoEm             DateTime? @map("concluido_em") @db.Timestamptz
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao               Transacao @relation(fields: [transacaoId], references: [id])
  contaProvedor           ContaProvedor @relation(fields: [contaProvedorId], references: [id])

  @@unique([transacaoId, numeroTentativa])
  @@index([idTransacaoLiquidante])
  // Índice parcial UNIQUE (transacao_id) WHERE situacao IN (ENVIANDO, SUCESSO):
  // migration 20260809180000_tentativa_saque_unica_ativa — anti double-pay.
  @@map("tentativas_transacoes")
}

model HistoricoSituacaoTransacao {
