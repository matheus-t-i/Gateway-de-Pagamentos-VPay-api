model ConfiguracaoPadraoPixUsuario {
  id                          BigInt              @id @default(autoincrement())
  nome                        String              @unique @db.VarChar(120)
  descricao                   String?
  tipoPessoa                  TipoPessoa?         @map("tipo_pessoa")
  padraoSistema               Boolean             @default(false) @map("padrao_sistema")
  ativo                       Boolean             @default(true)
  contaProvedorPixEntradaId   BigInt              @map("conta_provedor_pix_entrada_id")
  contaProvedorPixSaidaId     BigInt              @map("conta_provedor_pix_saida_id")
  taxaPixEntradaPercentual    Decimal             @default(0) @map("taxa_pix_entrada_percentual") @db.Decimal(7, 4)
  taxaPixEntradaFixa          Decimal             @default(0) @map("taxa_pix_entrada_fixa") @db.Decimal(19, 4)
  taxaPixSaidaPercentual      Decimal             @default(0) @map("taxa_pix_saida_percentual") @db.Decimal(7, 4)
  taxaPixSaidaFixa            Decimal             @default(0) @map("taxa_pix_saida_fixa") @db.Decimal(19, 4)
  ticketMinimoPixEntrada      Decimal             @default(0) @map("ticket_minimo_pix_entrada") @db.Decimal(19, 2)
  ticketMaximoPixEntrada      Decimal             @map("ticket_maximo_pix_entrada") @db.Decimal(19, 2)
  ticketMinimoPixSaida        Decimal             @default(0) @map("ticket_minimo_pix_saida") @db.Decimal(19, 2)
  ticketMaximoPixSaida        Decimal?            @map("ticket_maximo_pix_saida") @db.Decimal(19, 2)
  permitirPixSaidaViaApi      Boolean             @default(false) @map("permitir_pix_saida_via_api")
  diasLiberacaoSaldo          Int                 @default(0) @map("dias_liberacao_saldo")
  percentualReserva           Decimal             @default(0) @map("percentual_reserva") @db.Decimal(7, 4)
  baseCalculoReserva          BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva")
  diasRetencaoReserva         Int                 @default(0) @map("dias_retencao_reserva")
  modoTratamentoMed           ModoTratamentoMed   @default(BLOQUEAR_SALDO) @map("modo_tratamento_med")
  permiteSaldoNegativo        Boolean             @default(false) @map("permite_saldo_negativo")
  criadoEm                    DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  contaEntrada                ContaProvedor       @relation("PadraoEntrada", fields: [contaProvedorPixEntradaId], references: [id])
  contaSaida                  ContaProvedor       @relation("PadraoSaida", fields: [contaProvedorPixSaidaId], references: [id])
  configsUsuario              ConfiguracaoPixUsuario[]

  @@map("configuracoes_padrao_pix_usuarios")
}

/// Configuração efetiva do cliente. `contaProvedorPixEntradaId` é a adquirente
/// de PIX in EM USO: o administrador define a inicial e o próprio cliente troca,
/// dentro do que estiver liberado para ele (ver `LiberacaoAdquirenteUsuario`).
model ConfiguracaoPixUsuario {
  usuarioId                     BigInt              @id @map("usuario_id")
  configuracaoPadraoOrigemId    BigInt?             @map("configuracao_padrao_origem_id")
  contaProvedorPixEntradaId     BigInt              @map("conta_provedor_pix_entrada_id")
  contaProvedorPixSaidaId       BigInt              @map("conta_provedor_pix_saida_id")
  /// Quando a adquirente de PIX in foi trocada pela última vez (cliente ou admin).
  adquirentePixEntradaTrocadaEm DateTime?           @map("adquirente_pix_entrada_trocada_em") @db.Timestamptz
  taxaPixEntradaPercentual      Decimal             @default(0) @map("taxa_pix_entrada_percentual") @db.Decimal(7, 4)
  taxaPixEntradaFixa            Decimal             @default(0) @map("taxa_pix_entrada_fixa") @db.Decimal(19, 4)
  taxaPixSaidaPercentual        Decimal             @default(0) @map("taxa_pix_saida_percentual") @db.Decimal(7, 4)
  taxaPixSaidaFixa              Decimal             @default(0) @map("taxa_pix_saida_fixa") @db.Decimal(19, 4)
  ticketMinimoPixEntrada        Decimal             @default(0) @map("ticket_minimo_pix_entrada") @db.Decimal(19, 2)
  ticketMaximoPixEntrada        Decimal             @map("ticket_maximo_pix_entrada") @db.Decimal(19, 2)
  ticketMinimoPixSaida          Decimal             @default(0) @map("ticket_minimo_pix_saida") @db.Decimal(19, 2)
  ticketMaximoPixSaida          Decimal?            @map("ticket_maximo_pix_saida") @db.Decimal(19, 2)
  permitirPixSaidaViaApi        Boolean             @default(false) @map("permitir_pix_saida_via_api")
  diasLiberacaoSaldo            Int                 @default(0) @map("dias_liberacao_saldo")
  percentualReserva             Decimal             @default(0) @map("percentual_reserva") @db.Decimal(7, 4)
  baseCalculoReserva            BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva")
  diasRetencaoReserva           Int                 @default(0) @map("dias_retencao_reserva")
  modoTratamentoMed             ModoTratamentoMed   @default(BLOQUEAR_SALDO) @map("modo_tratamento_med")
  permiteSaldoNegativo          Boolean             @default(false) @map("permite_saldo_negativo")
  atualizadoPorUsuarioId        BigInt?             @map("atualizado_por_usuario_id")
  criadoEm                      DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                  DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                       Usuario             @relation(fields: [usuarioId], references: [id])
  padraoOrigem                  ConfiguracaoPadraoPixUsuario? @relation(fields: [configuracaoPadraoOrigemId], references: [id])
  contaEntrada                  ContaProvedor       @relation("UsuarioEntrada", fields: [contaProvedorPixEntradaId], references: [id])
  contaSaida                    ContaProvedor       @relation("UsuarioSaida", fields: [contaProvedorPixSaidaId], references: [id])

  @@index([contaProvedorPixEntradaId])
  @@map("configuracoes_pix_usuarios")
}

// =========================================================
// TRANSACOES
// =========================================================

model Transacao {
  id                                  BigInt              @id @default(autoincrement())
  idTransacaoPublico                  String              @unique @default(uuid()) @map("id_transacao_publico") @db.Uuid
  idTransacaoPrivado                  String              @unique @default(uuid()) @map("id_transacao_privado") @db.Uuid
  usuarioId                           BigInt              @map("usuario_id")
  credencialApiId                     BigInt?             @map("credencial_api_id")
  contaProvedorId                     BigInt?             @map("conta_provedor_id")
  transacaoOrigemId                   BigInt?             @map("transacao_origem_id")
  referenciaExterna                   String?             @map("referencia_externa") @db.VarChar(255)
  /// Callback informado NA CRIAÇÃO desta operação (equivale ao `postbackUrl`).
  /// Recebe os mesmos eventos dos webhooks do painel; se a URL for igual à de
  /// um webhook cadastrado, a entrega acontece uma única vez.
  urlCallback                         String?             @map("url_callback")
  direcao                             DirecaoTransacao
  moeda                               String              @default("BRL") @db.VarChar(3)
  valorBruto                          Decimal             @map("valor_bruto") @db.Decimal(19, 2)
  tarifaPixPercentualAplicada         Decimal             @default(0) @map("tarifa_pix_percentual_aplicada") @db.Decimal(7, 4)
  tarifaPixFixaAplicada               Decimal             @default(0) @map("tarifa_pix_fixa_aplicada") @db.Decimal(19, 4)
  valorTarifaPix                      Decimal             @default(0) @map("valor_tarifa_pix") @db.Decimal(19, 2)
  custoPixProvedorPercentualAplicado  Decimal             @default(0) @map("custo_pix_provedor_percentual_aplicado") @db.Decimal(7, 4)
  custoPixProvedorFixoAplicado        Decimal             @default(0) @map("custo_pix_provedor_fixo_aplicado") @db.Decimal(19, 4)
  valorCustoPixProvedor               Decimal             @default(0) @map("valor_custo_pix_provedor") @db.Decimal(19, 2)
  valorLiquidacaoEmpresa              Decimal             @map("valor_liquidacao_empresa") @db.Decimal(19, 2)
  valorReserva                        Decimal             @default(0) @map("valor_reserva") @db.Decimal(19, 2)
  valorDisponivelPrevisto             Decimal             @default(0) @map("valor_disponivel_previsto") @db.Decimal(19, 2)
  valorMargemBruta                    Decimal             @default(0) @map("valor_margem_bruta") @db.Decimal(19, 2)
  modoCobrancaTarifaAplicado          String              @default("AUTOMATICO_POR_DIRECAO") @map("modo_cobranca_tarifa_aplicado") @db.VarChar(40)
  diasLiberacaoSaldoAplicado          Int                 @default(0) @map("dias_liberacao_saldo_aplicado")
  percentualReservaAplicado           Decimal             @default(0) @map("percentual_reserva_aplicado") @db.Decimal(7, 4)
  baseCalculoReservaAplicada          BaseCalculoReserva  @default(VALOR_LIQUIDO_EMPRESA) @map("base_calculo_reserva_aplicada")
  diasRetencaoReservaAplicado         Int                 @default(0) @map("dias_retencao_reserva_aplicado")
  liberarSaldoEm                      DateTime?           @map("liberar_saldo_em") @db.Timestamptz
  liberarReservaEm                    DateTime?           @map("liberar_reserva_em") @db.Timestamptz
  situacao                            SituacaoTransacao   @default(PENDENTE)
  metadados                           Json                @default("{}")
  liquidadoEm                         DateTime?           @map("liquidado_em") @db.Timestamptz
  concluidoEm                         DateTime?           @map("concluido_em") @db.Timestamptz
  primeiroMedRecebidoEm               DateTime?           @map("primeiro_med_recebido_em") @db.Timestamptz
  falhouEm                            DateTime?           @map("falhou_em") @db.Timestamptz
  criadoEm                            DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                        DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                             Usuario             @relation(fields: [usuarioId], references: [id])
  credencialApi                       CredencialApi?      @relation(fields: [credencialApiId], references: [id])
  contaProvedor                       ContaProvedor?      @relation(fields: [contaProvedorId], references: [id])
  transacaoOrigem                     Transacao?          @relation("TransacaoDerivada", fields: [transacaoOrigemId], references: [id])
  derivadas                           Transacao[]         @relation("TransacaoDerivada")
  pix                                 TransacaoPix?
  itens                               ItemCobranca[]
  tentativas                          TentativaTransacao[]
  historicosSituacao                  HistoricoSituacaoTransacao[]
  movimentacoes                       MovimentacaoSaldo[]
  liberacoes                          LiberacaoSaldo[]
  casosMed                            CasoMed[]
  devolucoes                          DevolucaoPix[]
  chavesIdempotencia                  ChaveIdempotencia[]
  falhasAdquirente                    FalhaAdquirente[]

  @@unique([usuarioId, referenciaExterna])
  @@index([usuarioId])
  @@index([situacao])
  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("transacoes")
}

model TransacaoPix {
  transacaoId               BigInt    @id @map("transacao_id")
  txid                      String?   @db.VarChar(35)
  identificadorFimAFim      String?   @map("identificador_fim_a_fim") @db.VarChar(255)
  nomePagador               String?   @map("nome_pagador") @db.VarChar(255)
  documentoPagador          String?   @map("documento_pagador") @db.VarChar(20)
  emailPagador              String?   @map("email_pagador") @db.VarChar(255)
  telefonePagador           String?   @map("telefone_pagador") @db.VarChar(20)
  nomeBeneficiario          String?   @map("nome_beneficiario") @db.VarChar(255)
  documentoBeneficiario     String?   @map("documento_beneficiario") @db.VarChar(20)
  /// Endereço do pagador (logradouro, numero, complemento, cep, bairro,
  /// cidade, uf, pais). Obrigatório na cobrança quando algum item é TANGÍVEL —
  /// produto físico precisa de entrega. JSON pelo mesmo motivo de
  /// `Usuario.endereco`: é um bloco lido inteiro, nunca filtrado por campo.
  enderecoPagador           Json?     @map("endereco_pagador")
  chavePix                  String?   @map("chave_pix") @db.VarChar(255)
  tipoChavePix              String?   @map("tipo_chave_pix") @db.VarChar(20)
  pixCopiaCola              String?   @map("pix_copia_cola")
  urlCheckout               String?   @map("url_checkout")
  expiraEm                  DateTime? @map("expira_em") @db.Timestamptz
  criadoEm                  DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz

  transacao                 Transacao @relation(fields: [transacaoId], references: [id])

  @@index([txid])
  @@index([identificadorFimAFim])
  @@map("transacoes_pix")
}

/// Itens (produtos/serviços) da cobrança. Obrigatórios na API pública de
/// cobrança — é o que o lojista está vendendo, e sem isso o relatório de
/// cash-in só sabe mostrar a `referenciaExterna`.
///
/// Os valores são PERSISTIDOS por item (não recalculados na leitura): mudança
/// de preço no catálogo do lojista não pode reescrever o histórico da venda.
model ItemCobranca {
  id             BigInt   @id @default(autoincrement())
  transacaoId    BigInt   @map("transacao_id")
  titulo         String   @db.VarChar(255)
  quantidade     Int
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(19, 2)
  /// quantidade × valorUnitario no momento da venda.
  valorTotal     Decimal  @map("valor_total") @db.Decimal(19, 2)
  /// Produto físico (exige endereço de entrega) x digital/serviço.
  tangivel       Boolean
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao      Transacao @relation(fields: [transacaoId], references: [id])

  @@index([transacaoId])
  @@map("itens_cobranca")
}

model TentativaTransacao {
  id                      BigInt   @id @default(autoincrement())
  transacaoId             BigInt   @map("transacao_id")
  contaProvedorId         BigInt   @map("conta_provedor_id")
  numeroTentativa         Int      @map("numero_tentativa")
  situacao                String   @db.VarChar(30)
  idTransacaoLiquidante   String?  @map("id_transacao_liquidante") @db.VarChar(255)
  statusHttp              Int?     @map("status_http")
  codigoErro              String?  @map("codigo_erro") @db.VarChar(100)
  mensagemErro            String?  @map("mensagem_erro")
  dadosRequisicao         Json?    @map("dados_requisicao")
  dadosResposta           Json?    @map("dados_resposta")
  latenciaMs              Int?     @map("latencia_ms")
  iniciadoEm              DateTime @default(now()) @map("iniciado_em") @db.Timestamptz
  concluidoEm             DateTime? @map("concluido_em") @db.Timestamptz
  criadoEm                DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao               Transacao @relation(fields: [transacaoId], references: [id])
  contaProvedor           ContaProvedor @relation(fields: [contaProvedorId], references: [id])

  @@unique([transacaoId, numeroTentativa])
  @@index([idTransacaoLiquidante])
  @@map("tentativas_transacoes")
}

model HistoricoSituacaoTransacao {
  id               BigInt   @id @default(autoincrement())
  transacaoId      BigInt   @map("transacao_id")
  situacaoAnterior String?  @map("situacao_anterior") @db.VarChar(40)
  novaSituacao     String   @map("nova_situacao") @db.VarChar(40)
  origem           String   @db.VarChar(30)
  motivo           String?
  metadados        Json     @default("{}")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz

  transacao        Transacao @relation(fields: [transacaoId], references: [id])

  @@index([transacaoId])
  @@map("historicos_situacoes_transacoes")
}

model ChaveIdempotencia {
  id                BigInt    @id @default(autoincrement())
  usuarioId         BigInt    @map("usuario_id")
  credencialApiId   BigInt?   @map("credencial_api_id")
  chaveIdempotencia String    @map("chave_idempotencia") @db.VarChar(255)
  hashRequisicao    String    @map("hash_requisicao") @db.VarChar(255)
  transacaoId       BigInt?   @map("transacao_id")
  statusResposta    Int?      @map("status_resposta")
  corpoResposta     Json?     @map("corpo_resposta")
  expiraEm          DateTime  @map("expira_em") @db.Timestamptz
  criadoEm          DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  credencialApi     CredencialApi? @relation(fields: [credencialApiId], references: [id])
  transacao         Transacao?     @relation(fields: [transacaoId], references: [id])

  @@unique([usuarioId, chaveIdempotencia])
  @@map("chaves_idempotencia")
}

model DevolucaoPix {
  id                            BigInt   @id @default(autoincrement())
  idDevolucaoPublico            String   @unique @default(uuid()) @map("id_devolucao_publico") @db.Uuid
  transacaoId                   BigInt   @map("transacao_id")
  casoMedId                     BigInt?  @map("caso_med_id")
  solicitadoPorUsuarioId        BigInt?  @map("solicitado_por_usuario_id")
  referenciaExterna             String?  @map("referencia_externa") @db.VarChar(255)
  identificadorDevolucaoProvedor String? @map("identificador_devolucao_provedor") @db.VarChar(255)
  valor                         Decimal  @db.Decimal(19, 2)
  motivo                        String?
  situacao                      String   @default("PENDENTE") @db.VarChar(30)
  metadados                     Json     @default("{}")
  criadoEm                      DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm                  DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  transacao                     Transacao @relation(fields: [transacaoId], references: [id])
  casoMed                       CasoMed?  @relation(fields: [casoMedId], references: [id])
  movimentacoes                 MovimentacaoSaldo[]

  @@map("devolucoes_pix")
}

