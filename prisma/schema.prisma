model SaldoUsuario {
  usuarioId               BigInt   @id @map("usuario_id")
  saldoDisponivel         Decimal  @default(0) @map("saldo_disponivel") @db.Decimal(19, 2)
  saldoPendenteLiberacao  Decimal  @default(0) @map("saldo_pendente_liberacao") @db.Decimal(19, 2)
  saldoReservado          Decimal  @default(0) @map("saldo_reservado") @db.Decimal(19, 2)
  saldoBloqueadoMed       Decimal  @default(0) @map("saldo_bloqueado_med") @db.Decimal(19, 2)
  atualizadoEm            DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                 Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("saldos_usuarios")
}

model MovimentacaoSaldo {
  id                         BigInt               @id @default(autoincrement())
  idPublico                  String               @unique @default(uuid()) @map("id_publico") @db.Uuid
  usuarioId                  BigInt               @map("usuario_id")
  transacaoId                BigInt?              @map("transacao_id")
  devolucaoPixId             BigInt?              @map("devolucao_pix_id")
  casoMedId                  BigInt?              @map("caso_med_id")
  movimentacaoRelacionadaId  BigInt?              @map("movimentacao_relacionada_id")
  chaveIdempotencia          String               @unique @map("chave_idempotencia") @db.VarChar(255)
  tipoSaldo                  TipoSaldo            @map("tipo_saldo")
  tipoMovimento              TipoMovimento        @map("tipo_movimento")
  natureza                   NaturezaMovimentacao
  valor                      Decimal              @db.Decimal(19, 2)
  saldoApos                  Decimal              @map("saldo_apos") @db.Decimal(19, 2)
  descricao                  String?              @db.VarChar(500)
  metadados                  Json                 @default("{}")
  ocorridoEm                 DateTime             @default(now()) @map("ocorrido_em") @db.Timestamptz
  criadoEm                   DateTime             @default(now()) @map("criado_em") @db.Timestamptz

  transacao                  Transacao?           @relation(fields: [transacaoId], references: [id])
  devolucaoPix               DevolucaoPix?        @relation(fields: [devolucaoPixId], references: [id])
  casoMed                    CasoMed?             @relation(fields: [casoMedId], references: [id])
  relacionada                MovimentacaoSaldo?   @relation("MovRelacionada", fields: [movimentacaoRelacionadaId], references: [id])
  relacionadas               MovimentacaoSaldo[]  @relation("MovRelacionada")
  liberacoes                 LiberacaoSaldo[]

  @@index([usuarioId])
  @@index([transacaoId])
  @@index([ocorridoEm])
  @@map("movimentacoes_saldo")
}

model LiberacaoSaldo {
  id                      BigInt            @id @default(autoincrement())
  usuarioId               BigInt            @map("usuario_id")
  transacaoId             BigInt            @map("transacao_id")
  tipoLiberacao           TipoLiberacao     @map("tipo_liberacao")
  valor                   Decimal           @db.Decimal(19, 2)
  liberarEm               DateTime          @map("liberar_em") @db.Timestamptz
  situacao                SituacaoLiberacao @default(AGENDADA)
  movimentacaoLiberacaoId BigInt?           @map("movimentacao_liberacao_id")
  quantidadeTentativas    Int               @default(0) @map("quantidade_tentativas")
  ultimoErro              String?           @map("ultimo_erro")
  processadoEm            DateTime?         @map("processado_em") @db.Timestamptz
  criadoEm                DateTime          @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm            DateTime          @updatedAt @map("atualizado_em") @db.Timestamptz

  transacao               Transacao         @relation(fields: [transacaoId], references: [id])
  movimentacao            MovimentacaoSaldo? @relation(fields: [movimentacaoLiberacaoId], references: [id])

  @@unique([transacaoId, tipoLiberacao])
  @@index([situacao, liberarEm])
  @@map("liberacoes_saldo")
}

model BloqueioSaldo {
  id                  BigInt   @id @default(autoincrement())
  idPublico           String   @unique @default(uuid()) @map("id_publico") @db.Uuid
  usuarioId           BigInt   @map("usuario_id")
  casoMedId           BigInt?  @map("caso_med_id")
  tipo                String   @db.VarChar(30)
