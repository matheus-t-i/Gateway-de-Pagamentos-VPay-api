model EntregaWebhook {
  id                     BigInt    @id @default(autoincrement())
  eventoOutboxId         BigInt    @map("evento_outbox_id")
  /// Nulo quando a entrega foi para o `urlCallback` da própria operação, que
  /// não tem cadastro no painel.
  configuracaoWebhookId  BigInt?   @map("configuracao_webhook_id")
  /// URL efetivamente chamada — a config pode ser editada depois e o histórico
  /// precisa dizer para onde a entrega foi de fato.
  urlDestino             String?   @map("url_destino")
  usuarioId              BigInt    @map("usuario_id")
  numeroTentativa        Int       @map("numero_tentativa")
  situacao               String    @db.VarChar(30)
  statusHttp             Int?      @map("status_http")
  corpoResposta          String?   @map("corpo_resposta")
  mensagemErro           String?   @map("mensagem_erro")
  latenciaMs             Int?      @map("latencia_ms")
  solicitadoEm           DateTime  @default(now()) @map("solicitado_em") @db.Timestamptz
  enviadoEm              DateTime? @map("enviado_em") @db.Timestamptz
  proximaTentativaEm     DateTime? @map("proxima_tentativa_em") @db.Timestamptz
  criadoEm               DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  eventoOutbox           EventoOutbox @relation(fields: [eventoOutboxId], references: [id])
  configuracao           ConfiguracaoWebhookUsuario? @relation(fields: [configuracaoWebhookId], references: [id])

  @@unique([eventoOutboxId, configuracaoWebhookId, numeroTentativa])
  @@map("entregas_webhook")
}

// =========================================================
// INTEGRACOES (apps conectados pelo lojista)
// =========================================================

/// Um app conectado à conta do lojista (ex.: Utmify). Diferente do webhook, que
/// entrega o NOSSO contrato numa URL dele, aqui a VPay fala o contrato do app —
/// por isso a credencial é do app e o formato do corpo é ditado por eles.
model IntegracaoUsuario {
  id                        BigInt         @id @default(autoincrement())
  idPublico                 String         @unique @default(uuid()) @map("id_publico") @db.Uuid
  usuarioId                 BigInt         @map("usuario_id")
  tipo                      TipoIntegracao
  /// Rótulo do lojista ("Utmify — loja principal"). Só para ele se achar quando
  /// tem mais de uma conta no mesmo app.
  nome                      String         @db.VarChar(100)
  /// Credencial do app (Utmify: `x-api-token`), AES-256-GCM. Nunca volta pela
  /// API — o painel mostra apenas se está configurada.
  ///
  /// NULA quando o app não tem credencial (Xtracky: o endpoint de conversão
  /// não aceita autenticação e a conta é resolvida pelo LeadId dentro do
  /// pedido). Gravar string vazia cifrada faria o painel dizer "credencial
  /// configurada" para uma integração que não tem nenhuma.
  credenciaisCriptografadas String?        @map("credenciais_criptografadas")
  /// Eventos assinados (`EVENTOS_INTEGRACAO`). Lista vazia = todos, mesma
  /// convenção do `tiposEvento` do webhook.
  eventos                   Json           @default("[]")
  /// Envia com `isTest: true`: o app valida o payload e NÃO grava o pedido.
  /// Existe para o lojista conferir a ligação sem sujar o relatório dele.
  modoTeste                 Boolean        @default(false) @map("modo_teste")
  ativo                     Boolean        @default(true)
  criadoEm                  DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario                   Usuario        @relation(fields: [usuarioId], references: [id])
  envios                    EnvioIntegracao[]

  @@index([usuarioId])
  @@index([usuarioId, ativo])
  @@map("integracoes_usuario")
}

/// Histórico de envio de UM estado de UM pedido para UM app.
///
/// A linha nasce PENDENTE antes do POST: é a unique abaixo que garante que o
/// mesmo pedido não seja enviado duas vezes no mesmo estado quando um job é
/// reprocessado à mão. Reenvio manual reaproveita a linha e soma tentativa.
model EnvioIntegracao {
  id              BigInt    @id @default(autoincrement())
  integracaoId    BigInt    @map("integracao_id")
  transacaoId     BigInt    @map("transacao_id")
  /// `status` enviado ao app (`STATUS_REMOTO_PEDIDO`): waiting_payment | paid | refunded.
  statusRemoto    String    @map("status_remoto") @db.VarChar(30)
  situacao        String    @default("PENDENTE") @db.VarChar(20)
  numeroTentativa Int       @default(0) @map("numero_tentativa")
  statusHttp      Int?      @map("status_http")
  corpoResposta   String?   @map("corpo_resposta")
  mensagemErro    String?   @map("mensagem_erro")
  latenciaMs      Int?      @map("latencia_ms")
  enviadoEm       DateTime? @map("enviado_em") @db.Timestamptz
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz

  integracao      IntegracaoUsuario @relation(fields: [integracaoId], references: [id])
  transacao       Transacao         @relation(fields: [transacaoId], references: [id])

  @@unique([integracaoId, transacaoId, statusRemoto])
  @@index([integracaoId, criadoEm])
  @@index([situacao])
  @@map("envios_integracao")
}

