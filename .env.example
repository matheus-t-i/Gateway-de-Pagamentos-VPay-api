DATABASE_URL=postgresql://vpay:vpay@localhost:5432/vpay?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_PORT=3001
WEB_URL=http://localhost:3000
NODE_ENV=development
ADMIN_EMAIL=admin@vpay.local
ADMIN_PASSWORD=Admin@123456
MOCK_PROVIDER_WEBHOOK_KEY=mock-webhook-x-key-dev
UPLOADS_DIR=./uploads

# E-mail (sem SMTP_HOST os e-mails são apenas registrados no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VPay <contato@vpay.com.br>
BRAND_NOME=VPay
BRAND_SITE=https://vpay.com.br
BRAND_EMAIL=contato@vpay.com.br
BRAND_WHATSAPP=+55 (11) 99999-9999

# Teto de espera por adquirente na criação da cobrança; estourou, cai na contingência.
CONTINGENCIA_TIMEOUT_SEGUNDOS=10

# ============================================================
# Valorion (liquidante real) — https://app.valorion.com.br/documentacao/
# Preencha as chaves abaixo para testar; as credenciais da conta no admin
# têm prioridade, e o que faltar lá cai nestes envs.
# ============================================================
# URL pública DESTA API (ngrok/produção) — obrigatória: monta o postbackUrl
# enviado à Valorion (ex.: https://abc123.ngrok-free.app)
API_PUBLIC_URL=
# x-api-key da fila de cash-in/out
VALORION_API_KEY=
# Chave PIX autorizada na Valorion (header X-Pix-Key)
VALORION_PIX_KEY=
# Basic dos endpoints do painel (status/saldo/refund); vazio = base64 da VALORION_API_KEY
VALORION_BASIC_KEY=
# Identificador numérico do seller na Valorion (obrigatório para devolução/MED)
VALORION_SELLER_ID=
# Token secreto anexado ao postbackUrl (?token=...) — a Valorion não assina
# webhook, este token + allowlist de IP são a Camada 2. Recomendado preencher.
VALORION_WEBHOOK_TOKEN=
# Overrides de host (deixe vazio para os padrões da documentação)
VALORION_BASE_URL=
VALORION_FILA_URL=
# Pagador padrão para cobrança sem dados do pagador (a Valorion exige
# nome/e-mail/CPF válidos) — use os seus dados nos testes
VALORION_PAGADOR_PADRAO_NOME=
VALORION_PAGADOR_PADRAO_EMAIL=
VALORION_PAGADOR_PADRAO_CPF=
VALORION_PAGADOR_PADRAO_IP=
