DATABASE_URL=postgresql://vpay:vpay@localhost:5432/vpay?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
# Issuer/audience separam JWT do painel do Bearer da API pública (mesmo secret).
JWT_ISSUER=vpay
JWT_AUDIENCE_PAINEL=vpay-painel
JWT_AUDIENCE_API=vpay-api
# Validade (segundos) do token Bearer da API publica (POST /v1/auth/token).
# Expirou = o lojista reemite com x-api-key/x-api-secret. A revogacao NAO
# depende disto: o guard rele a credencial no banco a cada requisicao.
API_TOKEN_TTL_SEGUNDOS=3600
# true = toda chamada /v1/* exige HMAC (x-vpay-timestamp/nonce/signature).
# Também dá para ligar por credencial (exigirAssinaturaHmac no painel).
API_HMAC_OBRIGATORIO=false
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_PORT=3001
WEB_URL=http://localhost:3000
NODE_ENV=development
# Nível do pino (stdout). Default info. `error` ESCONDE warn — 400 de negócio
# (ex. "Provedor/conta indisponível") some no Render. Não use error em prod.
# LOG_LEVEL=info
ADMIN_EMAIL=admin@vpay.local
ADMIN_PASSWORD=Admin@123456
MOCK_PROVIDER_WEBHOOK_KEY=mock-webhook-x-key-dev
UPLOADS_DIR=./uploads
# Em produção: TRUST_PROXY=1 (obrigatório atrás de Render/Vercel/nginx).
# Com Cloudflare na frente, req.ip sozinho vê o edge CF — webhooks usam
# cf-connecting-ip via extrairIpCliente (não precisa subir TRUST_PROXY).
TRUST_PROXY=0
# local = disco (dev). Em produção o boot exige s3 + bucket.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Vazio = S3 da AWS. Preenchido = storage COMPATÍVEL (Cloudflare R2, MinIO,
# Backblaze). Com endpoint custom o cliente desliga o checksum automático do
# SDK: desde ~3.729 ele manda `x-amz-checksum-crc32` em todo PutObject, e o R2
# recusa esse header — a app sobe normalmente e só o primeiro upload de
# documento falha, com 500. Ver `src/common/storage-r2.spec.ts`.
#
# Cloudflare R2:
#   S3_REGION=auto
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=0
# Credencial do bucket. Aceita TAMBÉM os nomes AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (é o par que o render.yaml pede) — vale qualquer um dos
# dois, mas em produção o boot exige que UM esteja preenchido: sem credencial a
# app sobe normalmente e só o upload de documento falha, com 500.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Só para infra com role de instância (ECS/EC2), onde o SDK resolve sozinho.
# No Render não existe role — deixe vazio.
S3_CREDENCIAL_IMPLICITA=

# E-mail (sem SMTP_HOST os e-mails são apenas registrados no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VPay <contato@vpay.com.br>
BRAND_NOME=VPay
BRAND_SITE=https://vpay.com.br
BRAND_EMAIL=contato@vpay.com.br
BRAND_WHATSAPP=+55 (11) 99999-9999

# Teto de espera por adquirente na criação da cobrança; estourou, cai na contingência.
CONTINGENCIA_TIMEOUT_SEGUNDOS=10

# ============================================================
# Valorion (liquidante real) — https://app.valorion.com.br/documentacao/
# Cinco adquirentes, mesma integração, saldo individual:
#   valorion    → VALORION_API_KEY
#   valorion_02 → VALORION_02_API_KEY
#   … até valorion_05.
# Credenciais da conta no admin têm prioridade; o que faltar cai nestes envs.
# Token de webhook é O MESMO nas cinco rotas.
# ============================================================
# URL pública DESTA API (ngrok/produção) — monta o postbackUrl
# Só a ORIGEM, sem path. Errado: .../api (vira /api/api/webhooks).
# Certo: https://abc123.ngrok-free.app  ou  https://vpay-api.onrender.com
API_PUBLIC_URL=
# x-api-key da fila de cash-in/out (uma por adquirente)
VALORION_API_KEY=
VALORION_02_API_KEY=
VALORION_03_API_KEY=
VALORION_04_API_KEY=
VALORION_05_API_KEY=
# Token secreto no postbackUrl (?token=) — Camada 2; compartilhado
VALORION_WEBHOOK_TOKEN=
# Overrides de host (deixe vazio para os padrões da documentação)
VALORION_BASE_URL=
VALORION_FILA_URL=

# ============================================================
# Tesouraria — destino do saque automático (saldo parado na adquirente)
# TESOURARIA_CHAVE_PIX = nome de OUTRA env onde está a chave real.
# Tipo/nome/documento do titular ficam no gatilho (banco).
# Ex.: TESOURARIA_CHAVE_PIX=CHAVE_PIX_BB_VPAY
#      CHAVE_PIX_BB_VPAY=sua-chave-pix-aqui
# ============================================================
TESOURARIA_CHAVE_PIX=
# CHAVE_PIX_BB_VPAY=

# Pepper do hash dos segredos de credencial de API (HMAC-SHA256).
# Fica FORA do banco de proposito: quem der dump da tabela credenciais_api sem
# esta variavel nao consegue confirmar um palpite de segredo.
# PERDER ISTO INVALIDA TODAS AS CREDENCIAIS DE API — sem recuperacao, porque o
# segredo em claro nao existe mais. Guarde no gerenciador de segredos e replique
# nos DOIS servicos (API e Worker).
API_SECRET_PEPPER=troque_por_32_bytes_hex_aleatorios

# ============================================================
# Cloudflare Turnstile (anti-bot no login do painel)
# Em development/test: deixe vazio → API aceita login sem token (fail-open).
# Em production: obrigatório (fail-closed no boot + no POST /auth/login).
# Chaves de teste Cloudflare (sempre passam):
#   secret 1x0000000000000000000000000000000AA
#   site key (web) 1x00000000000000000000AA
# ============================================================
TURNSTILE_SECRET_KEY=
